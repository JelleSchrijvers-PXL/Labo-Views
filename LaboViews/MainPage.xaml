<?xml version="1.0" encoding="utf-8" ?>
<ContentPage xmlns="http://schemas.microsoft.com/dotnet/2021/maui"
             xmlns:x="http://schemas.microsoft.com/winfx/2009/xaml"
             x:Class="LaboViews.MainPage">

    <ScrollView>
        <VerticalStackLayout
            Padding="30,0"
            Spacing="225">
            <Border WidthRequest="150" HeightRequest="150" Stroke="DarkGreen" StrokeThickness="4" StrokeShape="RoundRectangle 75">
                <Border.Shadow>
                    <Shadow Brush="DarkGrey" Offset="10,10" Radius="5" Opacity="1"></Shadow>
                </Border.Shadow>
                <Image Source="profile_picture.jpg" Aspect="AspectFill"></Image>
            </Border>
        </VerticalStackLayout>
    </ScrollView>

</ContentPage>